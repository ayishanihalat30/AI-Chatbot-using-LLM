ENVIRONMENT=development
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_MB=100

# --- Chat / vision: any OpenAI-compatible server -----------------------------------------
# Local Ollama (default):   ollama pull llama3.2
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
CHAT_MODEL=llama3.2
FALLBACK_CHAT_MODELS=
VISION_MODEL=
# Hosted open models example (Groq):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   CHAT_MODEL=llama-3.3-70b-versatile
#   FALLBACK_CHAT_MODELS=llama-3.1-8b-instant
#   VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Embeddings (local multilingual model; dim must match the database, 768) --------------
EMBED_BACKEND=local
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBED_DIM=768

# --- Speech to text (audio + video) --------------------------------------------------------
TRANSCRIBE_BACKEND=local
TRANSCRIBE_MODEL=small
# Hosted alternative (Groq): TRANSCRIBE_BACKEND=api  TRANSCRIBE_MODEL=whisper-large-v3-turbo
MODEL_CACHE_DIR=./model_cache
